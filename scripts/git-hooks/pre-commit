#!/usr/bin/env bash
# Blocks commits that would leak secrets: a real .env file, or anything
# that looks like a raw private key (32 bytes = 64 hex chars).
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$staged" ]; then
  exit 0
fi

# 1. Never allow committing an actual .env file (.env.example is fine).
while IFS= read -r f; do
  base=$(basename "$f")
  if [[ "$base" == .env* && "$base" != ".env.example" ]]; then
    echo "pre-commit: refusing to commit '$f' — looks like a real .env file, not .env.example." >&2
    exit 1
  fi
done <<< "$staged"

# 2. Scan staged additions for a bare private-key-shaped hex string,
# skipping the all-zero placeholder used throughout tests/scripts
# (ethers.ZeroHash).
hits=$(git diff --cached -U0 -- $staged | grep -E '^\+' | grep -Eio '0x[0-9a-f]{64}' | grep -vi '^+\?0x0\{64\}$' || true)
if [ -n "$hits" ]; then
  echo "pre-commit: staged changes contain a 32-byte hex value that could be a private key:" >&2
  echo "$hits" | sed 's/^/  /' >&2
  echo "If this is a real secret, unstage it now. If it's a legitimate constant/hash, commit with 'git commit --no-verify'." >&2
  exit 1
fi

exit 0
